<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(MatterBundleDirectory)' != ''">
    <Content Include="$(MatterBundleDirectory)\**\*" Exclude="$(MatterBundleDirectory)\**\*.ts;$(MatterBundleDirectory)\**\*.map">
      <Link>Matter\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <Target Name="WritePortableRuntimeManifest" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Copy SourceFiles="$(ProjectRuntimeConfigFilePath)" DestinationFiles="$(PublishDir)runtime-manifest.json" />
  </Target>
</Project>
